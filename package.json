{
  "name": "restaurant-pos",
  "private": true,
  "workspaces": ["packages/*", "apps/*", "e2e"],
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:migrate": "npm run migrate -w apps/server",
    "test": "vitest run",
    "test:unit": "vitest run",
    "typecheck": "tsc -p apps/server --noEmit",
    "verify": "npm run typecheck && npm run test:unit"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "@types/node": "^22.0.0"
  }
}
