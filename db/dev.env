# Configuration for a throwaway, loopback-only (127.0.0.1) DEVELOPMENT database
# and nothing else. These values are public on purpose. Never reuse them for
# anything reachable from a network, and never copy them into production.
#
# Read by docker compose (`--env-file`), by the npm scripts (`--env-file`), and
# by the vitest setup. A variable already set in the shell wins over this file.

POS_OWNER_USER=pos_owner
POS_OWNER_PASSWORD=devpassword
POS_DB_NAME=pos
POS_TEST_DB_NAME=pos_test
POS_APP_PASSWORD=apppassword

# The owner connection: only the migration runner and the provisioning step.
MIGRATION_DATABASE_URL=postgres://pos_owner:devpassword@127.0.0.1:5433/pos
# The application connection: unprivileged pos_app.
DATABASE_URL=postgres://pos_app:apppassword@127.0.0.1:5433/pos

# The key of the PIN lookup digest (HMAC-SHA256). Held outside PostgreSQL.
# At least 32 characters. A development value only.
PIN_PEPPER=dev-only-pin-pepper-not-a-secret-0123456789
